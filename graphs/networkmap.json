{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 520,
  "config": {
    "background": "#0d1117",
    "view": { "stroke": null }
  },
  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": 720
  },
  "params": [
    {
      "name": "minLength",
      "value": 0,
      "bind": {
        "input": "text",
        "name": "Minimum Line Length (Kilometers): "
      }
    },
    {
      "name": "maxLength",
      "value": 355,
      "bind": {
        "input": "text",
        "name": "Maximum Line Length (Kilometers): "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/world-110m.json",
        "format": { "type": "topojson", "feature": "countries" }
      },
      "transform": [{ "filter": "datum.id === 36" }],
      "mark": {
        "type": "geoshape",
        "fill": "#1a2332",
        "stroke": "#2d4057",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/railways_cleaned.geojson",
        "format": { "type": "json", "property": "features" }
      },
      "params": [
        {
          "name": "gaugeFilter",
          "select": { "type": "point", "fields": ["track_gauge"] },
          "bind": "legend"
        }
      ],
      "transform": [
        { "calculate": "datum.properties.track_gauge", "as": "track_gauge" },
        { "calculate": "datum.properties.owner", "as": "owner" },
        { "calculate": "datum.properties.length_km", "as": "length_km" },
        { "filter": "datum.length_km == null || (datum.length_km >= +minLength && datum.length_km <= +maxLength)" },
        { "filter": { "param": "gaugeFilter" } }
      ],
      "mark": {
        "type": "geoshape",
        "filled": false,
        "strokeCap": "round",
        "strokeJoin": "round"
      },
      "encoding": {
        "stroke": {
          "field": "track_gauge",
          "type": "nominal",
          "title": "Track Gauge",
          "scale": {
            "domain": ["Narrow: 1067mm", "Standard: 1435mm", "Broad: 1600mm"],
            "range": ["#e05252", "#f0a500", "#4a9fd4"]
          },
          "legend": {
            "orient": "bottom-left",
            "labelColor": "#ccd", 
            "titleColor": "#aab",
            "labelFontSize": 12,
            "title": "Track Gauge",
            "titleFont": "Courier Prime, monospace",
            "titlePadding": 5,
            "titleAnchor":"middle",
            "titleAlign": "center",
            "labelFont": "Courier Prime, monospace",
            "symbolStrokeWidth": 3,
            "padding": 8,
            "fillColor": "#0d1117",
            "strokeColor": "#2d4057"
          }
        },
        "strokeWidth": {
          "condition": [{
            "test": "datum.properties.tracks === 'Double' || datum.properties.tracks === 'Multiple'",
            "value": 3
          }],
          "value": 1.8
        },
        "opacity": { "value": 0.92 },
        "tooltip": [
          { "field": "properties.name",   "title": "Line:" },
          { "field": "track_gauge",        "title": "Gauge:" },
          { "field": "owner",              "title": "Owner:" },
          { "field": "length_km",          "title": "Length (Kilometers):", "format": ".2f" }
        ]
      }
    }
  ]
}