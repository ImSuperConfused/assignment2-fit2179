{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 520,
  "config": {
    "background": "#0d1117",
    "view": {
      "stroke": null
    }
  },
  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": 720
  },
  "layer": [
    {
      "data": {
        "url": "../data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.id === 36"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#1a2332",
        "stroke": "#2d4057",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "../data/railway_lines.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "calculate": "datum.properties.track_gauge",
          "as": "track_gauge"
        },
        {
          "calculate": "datum.properties.owner",
          "as": "owner"
        },
        {
          "filter": {"param": "gaugeFilter"}
        }
      ],
      "params": [
        {
          "name": "gaugeFilter",
          "select": {
            "type": "point",
            "fields": ["track_gauge"]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "geoshape",
        "filled": false,
        "strokeCap": "round",
        "strokeJoin": "round"
      },
      "encoding": {
        "stroke": {
          "field": "track_gauge",
          "type": "nominal",
          "title": "Track Gauge",
          "scale": {
            "domain": [
              "Narrow: 1067mm",
              "Standard: 1435mm",
              "Broad: 1600mm"
            ],
            "range": [
              "#e05252",
              "#f0a500",
              "#4a9fd4"
            ]
          },
          "legend": {
            "orient": "bottom-left",
            "labelColor": "#ccd",
            "titleColor": "#aab",
            "labelFontSize": 12,
            "title": "Track Gauge",
            "titleFont": "Courier Prime, monospace",
            "labelFont": "Courier Prime, monospace",
            "symbolStrokeWidth": 3,
            "padding": 8,
            "fillColor": "#0d1117",
            "strokeColor": "#2d4057"
          }
        },
        "strokeWidth": {
          "condition": [
            {
              "test": "datum.properties.tracks === 'Double' || datum.properties.tracks === 'Multiple'",
              "value": 3
            },
            {
              "test": "datum.properties.length_km > 50",
              "value": 2.5
            }
          ],
          "value": 1.8
        },
        "opacity": {
          "value": 0.92
        },
        "tooltip": [
          {"field": "properties.name", "title": "Line:"},
          {"field": "track_gauge", "title": "Gauge:"},
          {"field": "owner", "title": "Owner:"},
          {"field": "properties.length_km", "title": "Length (km):", "format": ".2f"}
        ]
      }
    }
  ]
}