{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 200,
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#8899aa",
      "titleColor": "#8899aa",
      "domainColor": "transparent",
      "tickColor": "transparent",
      "labelFont": "Libre Franklin, sans-serif",
      "labelFontSize": 11
    }
  },
  "data": {
    "url": "../data/heatmap_passengers_long.json"
  },
  "mark": {
    "type": "rect",
    "cornerRadius": 2
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "axis": {
        "title": null,
        "labelAngle": 0
      }
    },
    "y": {
      "field": "city",
      "type": "ordinal",
      "sort": ["Sydney", "Melbourne", "Brisbane", "Perth", "Adelaide"],
      "axis": {
        "title": null
      }
    },
    "color": {
      "field": "passengers",
      "type": "quantitative",
      "title": "Boardings (Millions)",
      "scale": {
        "type": "linear",
        "domain": [0, 95, 190, 285, 380],
        "range": ["#11141a", "#51401a", "#916b19", "#c89c37", "#ffcc55"]
      },
      "legend": {
        "orient": "right",
        "values": [0, 190, 380],
        "labelColor": "#aab",
        "titleColor": "#aab",
        "labelFont": "Courier Prime, monospace",
        "titleFont": "Libre Franklin, sans-serif",
        "titleFontSize": 11,
        "labelFontSize": 10,
        "gradientLength": 130
      }
    },
    "tooltip": [
      {"field": "city", "title": "State:"},
      {"field": "year", "title": "Financial Year:"},
      {"field": "passengers", "title": "Boardings:", "format": ".2f"}
    ]
  }
}