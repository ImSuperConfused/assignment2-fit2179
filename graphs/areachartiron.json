{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 340,
  "height": 340,
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    }
  },
  "title": {
    "text": "IRON ORE EXPORTS 2022 (Mt)",
    "subtitle": "Major ports only",
    "fontSize": 15,
    "fontWeight": "bold",
    "color": "#eee",
    "font": "Libre Franklin, sans-serif",
    "anchor": "start",
    "offset": 20
  },
  "data": {
    "url": "../data/iron_data.json"
  },
  "transform": [
    {
      "filter": "datum.Year == 2022"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "arc",
        "innerRadius": 40,
        "stroke": "#0d1117",
        "strokeWidth": 2,
        "opacity": 0.88
      },
      "encoding": {
        "theta": {
          "field": "Area",
          "type": "nominal",
          "scale": {
            "padding": 0
          },
          "sort": ["Port Hedland", "Dampier", "Geraldton", "Esperance"]
        },
        "radius": {
          "field": "Value",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "range": [40, 160]
          }
        },
        "color": {
          "field": "Area",
          "type": "nominal",
          "scale": {
            "domain": ["Port Hedland", "Dampier", "Geraldton", "Esperance"],
            "range": ["#f0a500", "#4a9fd4", "#7bd4a0", "#c47adb"]
          },
          "legend": {
            "orient": "right",
            "labelColor": "#ccd",
            "titleColor": "#aab",
            "fillColor": "transparent",
            "strokeColor": "transparent",
            "labelFont": "Libre Franklin, sans-serif",
            "labelFontSize": 12,
            "title": null,
            "symbolSize": 130
          }
        },
        "tooltip": [
          { "field": "Area", "title": "Port" },
          { "field": "Value", "title": "Exports 2022 (Mt)", "format": ".1f" }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "radiusOffset": -20,
        "fontSize": 12,
        "fontWeight": "bold",
        "font": "Libre Franklin, sans-serif"
      },
      "encoding": {
        "theta": {
          "field": "Area",
          "type": "nominal",
          "scale": {
            "padding": 0
          },
          "sort": ["Port Hedland", "Dampier", "Geraldton", "Esperance"]
        },
        "radius": {
          "field": "Value",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "range": [40, 160]
          }
        },
        "text": {
          "field": "Value",
          "type": "quantitative",
          "format": ".0f"
        },
        "color": {
          "value": "#ffffff"
        }
      }
    }
  ]
}