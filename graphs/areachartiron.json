{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,
  "config": {
    "background": "#0d1117",
    "view": {
      "stroke": null
    },
    "font": "Libre Franklin, sans-serif"
  },
  "data": {
    "url": "data/iron_data.json"
  },
  "transform": [
    {
      "calculate": "datum.Area === 'Port Hedland' ? 1 : datum.Area === 'Dampier' ? 2 : datum.Area === 'Geraldton' ? 3 : 4",
      "as": "stack_order"
    }
  ],
  "params": [
    {
      "name": "portSelect",
      "select": {
        "type": "point",
        "fields": ["Area"]
      },
      "bind": "legend"
    }
  ],
  "mark": {
    "type": "area",
    "interpolate": "monotone",
    "line": {
      "color": "#0d1117",
      "size": 1.5
    },
    "cursor": "pointer"
  },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "axis": {
        "labelFontSize": 13,
        "titleFontSize": 14,
        "labelColor": "#ccd",
        "domainColor": "#444",
        "grid": true,
        "ticks": false,
        "labelAngle": 0,
        "labelPadding": 10,
        "titleColor": "#aab",
        "title": "Year",
        "titlePadding": 10
      }
    },
    "y": {
      "field": "Value",
      "type": "quantitative",
      "stack": "zero",
      "axis": {
        "labelFontSize": 13,
        "titleFontSize": 14,
        "labelColor": "#94a3b8",
        "gridColor": "#1e293b",
        "domainColor": "#334155",
        "titleColor": "#aab",
        "title": "Total Exports (Million Tonnes)",
        "titlePadding": 10
      }
    },
    "color": {
      "field": "Area",
      "type": "nominal",
      "scale": {
        "domain": ["Port Hedland", "Dampier", "Geraldton", "Esperance"],
        "range": ["#E69F00", "#56B4E9", "#009E73", "#F0E442"]
      },
      "legend": {
        "orient": "top",
        "direction": "horizontal",
        "offset": 10,
        "title": "Export Port",
        "symbolType": "square",
        "symbolSize": 150,
        "labelColor": "#ccd",
        "titleColor": "#aab",
        "labelFontSize": 12,
        "titleFont": "Courier Prime, monospace",
        "titlePadding": 5,
        "labelFont": "Courier Prime, monospace",
        "symbolStrokeWidth": 3,
        "padding": 8,
        "fillColor": "#0d1117",
        "strokeColor": "#2d4057"
      }
    },
    "order": {
      "field": "stack_order",
      "type": "quantitative",
      "sort": "ascending"
    },
    "opacity": {
      "condition": {
        "param": "portSelect",
        "empty": true,
        "value": 0.95
      },
      "value": 0.15
    },
    "tooltip": [
      { "field": "Year", "title": "Year:" },
      { "field": "Area", "title": "Export Port:" },
      { "field": "Value", "title": "Volume (Million Tonnes):", "format": ".2f" }
    ]
  }
}