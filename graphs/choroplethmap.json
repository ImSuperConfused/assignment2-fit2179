{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 520,
  "config": {
    "background": "#0d1117",
    "view": { "stroke": null }
  },
  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": 700
  },
  "params": [
    {
      "name": "SelectYear",
      "value": 2023,
      "bind": {
        "input": "range",
        "min": 1998,
        "max": 2023,
        "step": 1,
        "name": "Year: "
      }
    }
  ],
  "data": {
    "url": "data/rail_expenditure_per_capita_all_years.json"
  },
  "transform": [
    { "filter": "datum.year == SelectYear" },
    {
      "calculate": "{'NSW':'New South Wales','VIC':'Victoria','QLD':'Queensland','SA':'South Australia','WA':'Western Australia','TAS':'Tasmania','NT':'Northern Territory','ACT':'Australian Capital Territory'}[datum.state]",
      "as": "state_full"
    },
    {
      "lookup": "state_full",
      "from": {
        "data": {
          "url": "data/state_boundaries.topojson",
          "format": { 
            "type": "topojson", 
            "feature": "state_boundaries" 
          }
        },
        "key": "properties.state_name_2021"
      },
      "as": "geo"
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "#0d1117",
    "strokeWidth": 1
  },
  "encoding": {
    "shape": {
      "field": "geo",
      "type": "geojson"
    },
    "color": {
      "field": "spend_per_capita",
      "type": "quantitative",
      "scale": {
        "scheme": "oranges",
        "domain": [0, 3000]
      },
      "legend": {
        "title": "Spend Per Capita AUD$",
        "titleAnchor":"middle",
        "titleAlign": "center",
        "orient": "bottom-right",
        "labelColor": "#8b949e",
        "titleColor": "#c9d1d9",
        "labelFont": "monospace",
        "offset": 10,
        "values": [0, 1500, 3000],
        "gradientLength": 200,
        "labelExpr": "datum.value === 0 ? '0' : datum.value === 1500 ? '1.5k' : '3k'",
        "padding": 15,
        "fillColor": "#0d1117",
        "strokeColor": "#1e293b"
      }
    },
    "tooltip": [
      { "field": "state", "type": "nominal", "title": "State:" },
      { "field": "year", "type": "quantitative", "title": "Year:" },
      { "field": "spend_per_capita", "type": "quantitative", "title": "Spend per Person (AUD$):", "format": "$,.2f" },
      { "field": "expenditure", "type": "quantitative", "title": "Total Spend (Millions AUD$):", "format": "$,.2f" },
      { "field": "population", "type": "quantitative", "title": "Total Population", "format": "," }
    ]
  }
}