{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 520,
  "config": {
    "background": "#0d1117",
    "view": {
      "stroke": null
    }
  },
  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": 720
  },
  "params": [
    {
      "name": "SelectYear",
      "value": 2023,
      "bind": {
        "input": "range",
        "min": 1998,
        "max": 2023,
        "step": 1,
        "name": "Financial Year: "
      }
    }
  ],
  "data": {
    "url": "../data/rail_expenditure_per_capita_all_years.json"
  },
  "transform": [
    {
      "filter": "datum.year == SelectYear"
    },
    {
      "calculate": "datum.state === 'NSW' ? 'New South Wales' : datum.state === 'VIC' ? 'Victoria' : datum.state === 'QLD' ? 'Queensland' : datum.state === 'SA' ? 'South Australia' : datum.state === 'WA' ? 'Western Australia' : datum.state === 'TAS' ? 'Tasmania' : datum.state === 'NT' ? 'Northern Territory' : datum.state === 'ACT' ? 'Australian Capital Territory' : 'Other'",
      "as": "state_full"
    },
    {
      "lookup": "state_full",
      "from": {
        "data": {
          "url": "state_boundaries.json",
          "format": {
            "type": "json",
            "property": "features"
          }
        },
        "key": "properties.state_name_2021"
      },
      "as": "geo"
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "#2d4057",
    "strokeWidth": 0.8
  },
  "encoding": {
    "shape": {
      "field": "geo",
      "type": "geojson"
    },
    "detail": {
      "field": "state",
      "type": "nominal"
    },
    "color": {
      "field": "spend_per_capita",
      "type": "quantitative",
      "scale": {
        "scheme": "oranges",
        "domain": [0, 2000]
      },
      "legend": {
        "orient": "bottom-right",
        "labelColor": "#aab",
        "titleColor": "#aab",
        "labelFont": "Courier Prime, monospace",
        "titleFont": "Libre Franklin, sans-serif",
        "labelFontSize": 10,
        "titleFontSize": 11,
        "offset": 10
      }
    },
    "tooltip": [
      {"field": "state_full", "type": "nominal", "title": "State"},
      {"field": "year", "type": "quantitative", "title": "Financial Year"},
      {"field": "spend_per_capita", "type": "quantitative", "title": "Spend per Person (AU$)", "format": "$,.2f"},
      {"field": "expenditure", "type": "quantitative", "title": "Total Spend (AU$M)", "format": "$,.1f"},
      {"field": "population", "type": "quantitative", "title": "Total Population", "format": ","}
    ]
  }
}