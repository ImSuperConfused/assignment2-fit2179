{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 200,
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "mark": {
      "invalid": null
    },
    "axis": {
      "labelColor": "#8899aa",
      "titleColor": "#8899aa",
      "domainColor": "transparent",
      "tickColor": "transparent",
      "labelFont": "Libre Franklin, sans-serif",
      "labelFontSize": 11
    }
  },
  "data": {
    "url": "data/fatalities_long.json"
  },
  "transform": [
    {
      "calculate": "{'NSW': 'New South Wales', 'VIC': 'Victoria', 'QLD': 'Queensland', 'SA': 'South Australia', 'WA': 'Western Australia', 'TAS': 'Tasmania', 'NT': 'Northern Territory', 'ACT': 'Australian Capital Territory'}[datum.state]",
      "as": "state_full"
    }
  ],
  "layer": [
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "on": "mouseover",
            "clear": "mouseout"
          }
        },
        {
          "name": "stateHighlight",
          "select": { "type": "point", "fields": ["state"] },
          "bind": {
            "input": "select",
            "options": [null, "NSW", "VIC", "QLD", "SA", "WA", "TAS", "NT", "ACT"],
            "labels": ["Show All", "New South Wales", "Victoria", "Queensland", "South Australia", "Western Australia", "Tasmania", "Northern Territory", "Australian Capital Territory"],
            "name": "Highlight State: "
          }
        }
      ],
      "mark": {
        "type": "rect",
        "cornerRadius": 2
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "axis": {
            "title": null,
            "labelAngle": 0
          }
        },
        "y": {
          "field": "state",
          "type": "ordinal",
          "sort": ["NSW", "VIC", "QLD", "SA", "WA", "TAS", "NT", "ACT"],
          "axis": {
            "title": null
          }
        },
        "color": {
          "condition": {
            "test": "!isValid(datum.fatalities)",
            "value": "#161b22"
          },
          "field": "fatalities",
          "type": "quantitative",
          "title": "Fatalities",
          "scale": {
            "type": "linear",
            "domain": [0, 3, 6, 9, 12],
            "range": ["#11141a", "#51401a", "#916b19", "#c89c37", "#ffcc55"]
          },
          "legend": {
            "orient": "right",
            "values": [0, 6, 12],
            "labelColor": "#aab",
            "titleColor": "#aab",
            "labelFont": "Courier Prime, monospace",
            "titleFont": "Libre Franklin, sans-serif",
            "titleAnchor":"middle",
            "titleAlign": "center",
            "titleFontSize": 11,
            "labelFontSize": 10,
            "gradientLength": 130
          }
        },
        "opacity": {
          "condition": { 
            "test": {
              "and": [
                {"param": "hover"},
                {"param": "stateHighlight"}
              ]
            }, 
            "value": 1 
          },
          "value": 0.15
        },
        "stroke": {
          "condition": { "param": "hover", "empty": false, "value": "#e8edf2" },
          "value": "transparent"
        },
        "strokeWidth": {
          "condition": { "param": "hover", "empty": false, "value": 1.5 },
          "value": 0
        },
        "tooltip": [
          {
            "field": "state_full",
            "title": "State"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "fatalities",
            "title": "Fatalities",
            "format": "d"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 10,
        "font": "Courier Prime, monospace",
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "state",
          "type": "ordinal",
          "sort": ["NSW", "VIC", "QLD", "SA", "WA", "TAS", "NT", "ACT"]
        },
        "text": {
          "condition": {
            "test": "!isValid(datum.fatalities)",
            "value": "null"
          },
          "value": ""
        },
        "color": {
          "value": "#64748b"
        },
        "opacity": {
          "condition": { 
            "test": {
              "and": [
                {"param": "hover"},
                {"param": "stateHighlight"}
              ]
            }, 
            "value": 1 
          },
          "value": 0.15
        },
        "tooltip": [
          {
            "field": "state_full",
            "title": "State"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "fatalities",
            "title": "Fatalities"
          }
        ]
      }
    }
  ]
}