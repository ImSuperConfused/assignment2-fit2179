{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 520,
  "config": {
    "background": "#0d1117",
    "view": {
      "stroke": null
    }
  },
  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": 720
  },
  "params": [
    {
      "name": "selectYear",
      "value": 2023,
      "bind": {
        "input": "range",
        "min": 2010,
        "max": 2023,
        "step": 1,
        "name": "Year Select: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.id === 36"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#1a2332",
        "stroke": "#2d4057",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/australian_city_transit_all_years.json",
        "format": {
          "type": "json"
        }
      },
      "transform": [
        {
          "filter": "datum.Year === selectYear"
        },
        {
          "calculate": "datum.lat + sqrt(datum.passengers_m)",
          "as": "peak_lat"
        }
      ],
      "layer": [
        {
          "params": [
            {
              "name": "citySelect",
              "select": {
                "type": "point",
                "fields": ["city"]
              },
              "bind": "legend"
            }
          ],
          "mark": {
            "type": "circle",
            "size": 40
          },
          "encoding": {
            "longitude": { "field": "lon", "type": "quantitative" },
            "latitude": { "field": "lat", "type": "quantitative" },
            "color": {
              "field": "city",
              "type": "nominal",
              "scale": {
                "domain": ["Sydney", "Melbourne", "Brisbane", "Perth", "Adelaide"],
                "range": ["#f0a500", "#4a9fd4", "#7bd4a0", "#e05252", "#c47adb"]
              },
              "legend": {
                "orient": "bottom-left",
                "labelColor": "#ccd",
                "titleColor": "#aab",
                "labelFontSize": 12,
                "title": "City",
                "titleFont": "Courier Prime, monospace",
                "titlePadding": 5,
                "titleAnchor":"middle",
                "titleAlign": "center",
                "labelFont": "Courier Prime, monospace",
                "symbolStrokeWidth": 0,
                "padding": 8,
                "fillColor": "#0d1117",
                "strokeColor": "#2d4057"
              }
            },
            "opacity": {
              "condition": { "param": "citySelect", "empty": true, "value": 1 },
              "value": 0.2
            }
          }
        },
        {
          "mark": {
            "type": "rule",
            "strokeWidth": 2.5
          },
          "encoding": {
            "longitude": { "field": "lon", "type": "quantitative" },
            "latitude": { "field": "lat", "type": "quantitative" },
            "longitude2": { "field": "lon" },
            "latitude2": { "field": "peak_lat" },
            "color": { "field": "city", "type": "nominal" },
            "opacity": {
              "condition": { "param": "citySelect", "empty": true, "value": 0.85 },
              "value": 0.15
            }
          }
        },
        {
          "mark": {
            "type": "point",
            "filled": true,
            "stroke": "#0d1117",
            "strokeWidth": 2
          },
          "encoding": {
            "longitude": { "field": "lon", "type": "quantitative" },
            "latitude": { "field": "peak_lat", "type": "quantitative" },
            "size": {
              "field": "pop_m",
              "type": "quantitative",
              "title": "City Population",
              "scale": {
                "type": "pow",
                "exponent": 2,
                "domain": [0, 8],
                "range": [50, 4000]
              },
              "legend": {
                "values": [0, 2, 4, 6, 8],
                "orient": "bottom-right",
                "titleFont": "Courier Prime, monospace",
                "labelFont": "Courier Prime, monospace",
                "labelColor": "#ccd",
                "titleColor": "#aab",
                "titlePadding": 5,
                "titleAnchor":"middle",
                "titleAlign": "center",
                "symbolType": "circle",
                "symbolFillColor": "#aab",
                "symbolStrokeColor": "#0d1117",
                "symbolStrokeWidth": 1.5,
                "symbolOpacity": 1,
                "padding": 12,
                "direction": "vertical",
                "fillColor": "#0d1117",
                "strokeColor": "#2d4057"
              }
            },
            "color": { "field": "city", "type": "nominal" },
            "opacity": {
              "condition": { "param": "citySelect", "empty": true, "value": 1 },
              "value": 0.15
            },
            "tooltip": [
              { "field": "city", "title": "City:" },
              { "field": "Year", "title": "Year:" },
              { "field": "passengers_m", "title": "Boardings (Millions):", "format": ".2f" },
              { "field": "pop_m", "title": "City Population (Millions):", "format": ".2f" }
            ]
          }
        }
      ]
    }
  ]
}