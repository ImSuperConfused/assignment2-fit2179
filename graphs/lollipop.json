{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 550,
  "config": {
    "background": "#0d1117",
    "view": {"stroke": null},
    "axis": {
      "domainColor": "#2d4057",
      "gridColor": "#1a2332",
      "tickColor": "#2d4057",
      "labelColor": "#aab",
      "titleColor": "#ccd",
      "labelFont": "Courier Prime, monospace",
      "titleFont": "Courier Prime, monospace"
    }
  },
  "data": {
    "url": "data/network_speeds.json"
  },
  "encoding": {
    "y": {
      "field": "Line",
      "type": "nominal",
      "sort": {
        "field": "Speed", 
        "op": "max", "order": 
        "descending"
      },
      "axis": {
        "title": "Route", 
        "labelFontSize": 11
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "strokeCap": "round",
        "opacity": 0.7
      },
      "encoding": {
        "x": {
          "field": "Speed",
          "type": "quantitative"
        },
        "x2": {"value": 0},
        "color": {
          "field": "Type",
          "type": "nominal",
          "scale": {
            "domain": ["Urban", "Regional"],
            "range": ["#4a9fd4", "#e05252"]
          },
          "legend": {
            "orient": "bottom-right",
            "labelColor": "#ccd",
            "titleColor": "#aab",
            "title": "Network",
            "titleAnchor":"middle",
            "titleAlign": "center",
            "titleFont": "Courier Prime, monospace",
            "labelFont": "Courier Prime, monospace",
            "symbolStrokeWidth": 3,
            "padding": 10,
            "fillColor": "#0d1117",
            "strokeColor": "#2d4057"
          }
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "opacity": 1,
        "stroke": "#0d1117",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "Speed",
          "type": "quantitative",
          "title": "Journey Speed (Kilometers Per Hour)",
          "scale": {"domain": [0, 100]}
        },
        "color": {
          "field": "Type",
          "type": "nominal"
        },
        "size": {
          "field": "Station_Spacing",
          "type": "quantitative",
          "title": "Average Station Spacing (Kilometers)",
          "scale": {"range": [50, 450]},
          "legend": null
        },
        "tooltip": [
          {"field": "Line", "title": "Route:"},
          {"field": "City", "title": "City/Region:"},
          {"field": "Type", "title": "Network:"},
          {"field": "Speed", "title": "Average Speed (Kilometers Per Hour):", "format": ".2f"},
          {"field": "Station_Spacing", "title": "Average Gap (Kilometers):", "format": ".2f"}
        ]
      }
    }
  ]
}