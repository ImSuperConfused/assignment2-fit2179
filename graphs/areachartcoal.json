{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Libre Franklin, sans-serif"
  },
  "data": {
    "url": "../data/coal_data.json"
  },
  "params": [
    {
      "name": "portHover",
      "select": {
        "type": "point",
        "fields": ["Area"],
        "on": "pointerover",
        "clear": "pointerout"
      }
    }
  ],
  "mark": {
    "type": "area",
    "interpolate": "monotone",
    "line": {
      "color": "#0d1117",
      "size": 1.5
    },
    "cursor": "pointer"
  },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "axis": {
        "labelColor": "#ccd",
        "domainColor": "#444",
        "grid": false,
        "ticks": false,
        "labelAngle": 0,
        "labelFontSize": 13,
        "labelPadding": 10,
        "title": null
      }
    },
    "y": {
      "field": "Value",
      "type": "quantitative",
      "stack": "zero",
      "axis": {
        "labelColor": "#94a3b8",
        "gridColor": "#1e293b",
        "domainColor": "#334155",
        "titleColor": "#aab",
        "title": "Total Exports (Mt)",
        "titlePadding": 10
      }
    },
    "color": {
      "field": "Area",
      "type": "nominal",
      "scale": {
        "domain": ["Newcastle", "Hay Point", "Gladstone", "Abbot Point", "Brisbane"],
        "range": ["#f0a500", "#4a9fd4", "#7bd4a0", "#e05252", "#c47adb"]
      },
      "legend": {
        "orient": "top",
        "labelColor": "#ccd",
        "titleColor": "#aab",
        "fillColor": "transparent",
        "strokeColor": "transparent",
        "labelFont": "Libre Franklin, sans-serif",
        "labelFontSize": 12,
        "title": null,
        "symbolType": "square",
        "symbolSize": 150,
        "direction": "horizontal",
        "offset": 10
      }
    },
    "opacity": {
      "condition": {
        "param": "portHover",
        "empty": true,
        "value": 0.95
      },
      "value": 0.15
    },
    "tooltip": [
      { "field": "Year", "title": "Year" },
      { "field": "Area", "title": "Export Port" },
      { "field": "Value", "title": "Volume (Mt)", "format": ".1f" }
    ]
  }
}